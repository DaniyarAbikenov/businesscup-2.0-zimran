# Copy to .env. Every value has a working default, so this file is optional for local development.
# DB_PORT is the port on your computer for DB tools (psql, pgAdmin). Inside Docker the app always uses 5432.
POSTGRES_USER=roleshift
POSTGRES_PASSWORD=roleshift
POSTGRES_DB=roleshift

FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5433

# Demo button on the sign-in page: a throwaway account with sample data at every step. Set to false in production.
DEMO_MODE=true

# Set to true when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=false

# OPTIONAL: AI wording suggestion. Leave empty and the whole app still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Pricing (test checkout only, no payment provider)
FREE_CASES=3
PASS_PRICE_CENTS=2900
PASS_DAYS=90
TEST_CHECKOUT=true

# OPTIONAL: email reminders (opt-in per user). With SMTP_HOST empty, emails are only written to the server log
# and the Redis list "outbox" (log mailer). APP_URL is the public address used in email links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RoleShift <no-reply@localhost>
APP_URL=http://localhost:5173

# Vercel (see DEPLOY_VERCEL.md). DATABASE_URL / REDIS_URL override the POSTGRES_* parts above; CRON_SECRET protects the daily job.
# DATABASE_URL=
# REDIS_URL=
# CRON_SECRET=
# AUTO_MIGRATE=true   # run `alembic upgrade head` once per cold start (advisory-locked). For hosts like Vercel. Leave unset locally.
